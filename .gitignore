# Python
.venv/
__pycache__/
*.pyc

# Credentials / local env — never commit
.env
.pricredit-env

# Raw & derived EDGAR data — regenerate from source.
# Keep bdc/README.md and the `bdc/` directory itself tracked so the
# structure is visible; everything else under the data dirs is transient.
filings/
extracted/
reports/
bdc/bdc_universe.json
bdc/bdc_universe_*.json
bdc/company_tickers.json
bdc/_cache/

# Send-idempotency markers (populated by send_risk_alerts.py and,
# in the future, send_reports.py). reports/ itself is already ignored
# above, but this makes the intent explicit for when we stop ignoring
# the whole reports/ tree.
reports/**/.sent/

# Scratch
tmp/
*.tmp
