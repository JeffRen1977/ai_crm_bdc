#!/usr/bin/env bash
# Thin wrapper so `pc status ARCC` works from any cwd. Prefers the
# repo's .venv interpreter if present so YAML/psycopg-backed commands
# pick up the same deps the daily pipeline uses.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PY="${PYTHON:-$ROOT/.venv/bin/python}"
[[ -x "$PY" ]] || PY="python3"
exec "$PY" "$SCRIPT_DIR/pc.py" "$@"
